# =====================================================================
# LOCAL WINDOWS SETUP (added by the environment setup, not upstream).
# Everything listed below is regenerable or third-party: deleting these
# paths does NOT damage the project source code.
# NOTE: git does not allow trailing comments in this file; keep the
# explanations above each pattern.
# =====================================================================

# python virtual env, recreate with win/README.md (section 3.1)
.venv/
# pip cache
.pip-cache/
# pip TMPDIR, must live inside the workspace on this box
.tmp/
# cloned/extracted third-party deps (GarmentCodeRC, ...)
repos/
# pygarment outputs
Logs/
# downloaded archives and partial download parts
*.zip
*.parts/
# 62 MB of upstream README animations, kept on disk but untracked
docs/images/*.gif

